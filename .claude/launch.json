{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "port": 8010,
      "env": {
        "DATABASE_URL": "postgresql://olrac:olrac_password@localhost:5432/olrac_signage",
        "SECRET_KEY": "local-dev-secret",
        "AWS_ACCESS_KEY_ID": "mock",
        "AWS_SECRET_ACCESS_KEY": "mock",
        "REDIS_URL": "redis://localhost:6379",
        "CORS_ORIGINS": "http://localhost:3000"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "./frontend",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
