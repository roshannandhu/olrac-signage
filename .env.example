# Olrac Signage — Environment variables
# Copy this file to .env and fill in real values.

# Supabase project settings (find in Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database — DIRECT connection string (port 5432, NOT the transaction pooler on 6543)
# Found in Supabase Dashboard → Settings → Database → Connection string → URI
# Use the "Session pooler" or "Direct" connection, NOT the "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Screen token signing secret (generate a random string: python -c "import secrets; print(secrets.token_urlsafe(32))")
SCREEN_TOKEN_SECRET=change-me-to-a-random-secret

# CORS — comma-separated origins for the admin and TV frontends
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
