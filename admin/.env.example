# Olrac Signage — Admin web app environment.
# Copy to `.env` (Vite reads VITE_* vars at build/dev time) and fill in real values.

# Base URL of the Olrac FastAPI backend.
VITE_API_URL=http://localhost:8000

# Supabase project (Dashboard → Project Settings → API).
# Used ONLY for admin auth; all other data flows through VITE_API_URL.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
