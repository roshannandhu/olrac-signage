# IMPORTANT: Postgres and Redis must be running for this application to function properly.
# (e.g. run via docker-compose up -d or native services)
DATABASE_URL=postgresql://olrac:olrac_password@localhost:5432/olrac_signage
# Any DSN the provider gives you works, including credentials and TLS:
#   redis://default:<password>@<host>:6379
#   rediss://default:<password>@<host>:6379   (TLS)
REDIS_URL=redis://localhost:6379

# Run the arq worker inside the API process instead of as its own service.
#
# Leave false with docker-compose, which already runs `worker` as a separate container --
# turning it on there would run every cron job twice.
#
# Set true on single-process hosts (Render/Railway free tiers give you a web service and
# no background worker). Something must run the worker or the product silently half-works:
# `process_media` never fires, so uploads never reach status="ready" and never reach a TV,
# and `aggregate_play_logs` never fires, so play_logs accumulate correctly while every
# dashboard count -- which reads PlayLogHourlyRollup -- stays at zero.
RUN_WORKER_IN_PROCESS=false
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=replace-with-at-least-8-characters
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# Optional Cloudflare R2 / S3 storage
AWS_ACCESS_KEY_ID=mock
AWS_SECRET_ACCESS_KEY=mock
AWS_REGION=auto
S3_ENDPOINT_URL=
S3_BUCKET_NAME=olrac-media

# Player release metadata, used only until the first AppRelease row exists. After that
# the releases table is authoritative and a build reaches unpinned screens only once it
# is promoted to rollout_state="released".
#
# PLAYER_APK_SHA256 is not optional in practice: the player refuses to install an APK it
# cannot verify, so a PLAYER_APK_URL without a digest will never install anywhere.
PLAYER_VERSION_CODE=1
PLAYER_VERSION_NAME=1.0
PLAYER_APK_URL=
PLAYER_APK_SHA256=
PLAYER_UPDATE_MANDATORY=false
PLAYER_SYNC_INTERVAL_SECONDS=60
SCREEN_OFFLINE_AFTER_SECONDS=150

# Device Owner QR Provisioning Settings
PROVISIONING_CERT_SHA256_BASE64=
PROVISIONING_APK_URL=

# Billing (use PAYMENT_PROVIDER=mock only in automated tests)
# Raw proof-of-play rows are billing evidence in advertiser disputes.
# Only rows already rolled up are pruned, once daily at 03:00.
PLAY_LOG_RETENTION_DAYS=180
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_MONTHLY_PLAN_ID=
RAZORPAY_STARTER_YEARLY_PLAN_ID=
RAZORPAY_BUSINESS_MONTHLY_PLAN_ID=
RAZORPAY_BUSINESS_YEARLY_PLAN_ID=
BILLING_GRACE_DAYS=7

# Proof-of-play raw log retention (billing evidence). Defaults to 180 days.

# Static map images inside client report PDFs. Without it the report prints the location
# list instead of a map -- it degrades, it does not fail.
GOOGLE_MAPS_API_KEY=

# Screenshots retained per screen by the nightly prune.
SCREENSHOT_KEEP_PER_SCREEN=10

# Signing a TV in with a Google account, instead of typing a password on the remote.
# Create the client in Google Cloud as type "TVs and Limited Input devices" -- that is the
# type that enables the device authorisation grant, and the only Google flow that works on
# a TV. The scopes used are openid/email/profile, all non-sensitive, so this needs no
# Google verification review to go into production.
#
# Leave both blank to switch the feature off: /api/screens/google/start then answers 503
# and the TV says so plainly, pointing the installer at the password route. The button
# stays on screen -- the player has no way to know the server's configuration before it
# asks -- and the password and pairing-code routes are unaffected.
#
# Google only proves who someone is. It does not enrol them: the address must already be
# on an active OLRAC user with an owner or editor role, or the screen is refused. Note
# that new accounts are created without an email, so it has to be set on the profile
# (dashboard, Account) before that user can sign a screen in this way.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
